{
  "name": "pdf-annotation-carryover",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Transfer PDF highlights and notes to a new version of the same PDF (Next.js PWA)",
  "scripts": {
    "prepare:assets": "tsx scripts/prepare-assets.ts",
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "npx --yes serve out",
    "typecheck": "tsc --noEmit && tsc -p sw/tsconfig.json",
    "test": "tsx test/test.ts && tsx test/test-short.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
